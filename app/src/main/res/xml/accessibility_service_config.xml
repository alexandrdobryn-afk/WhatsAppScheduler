<?xml version="1.0" encoding="utf-8"?>
<!--
    This service intentionally listens to a very small set of event types and is
    restricted, in code (see WhatsAppAccessibilityService), to events whose
    packageName equals the supported WhatsApp package name below. It never reads
    content from any other application.
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged|typeWindowContentChanged|typeViewClicked|typeViewFocused"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagReportViewIds"
    android:canRetrieveWindowContent="true"
    android:notificationTimeout="100"
    android:packageNames="com.whatsapp"
    android:description="@string/accessibility_service_description" />
